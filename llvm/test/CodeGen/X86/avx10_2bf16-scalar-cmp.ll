; RUN: llc < %s -verify-machineinstrs -mtriple=x86_64-unknown-unknown -mattr=+avx10.2 | FileCheck %s --check-prefixes=CHECK

; AVX10.2 has a scalar bf16 compare, VCOMISBF16. It always flushes denormal
; inputs to zero, while the f32 promotion it replaces (vpslld $16 + vucomiss)
; compares bf16 denormals exactly, so it is only used in functions whose
; denormal-fp environment already flushes denormal inputs.

;===----------------------------------------------------------------------===;
; Predicates, with denormal inputs flushed: all of these use VCOMISBF16.
;===----------------------------------------------------------------------===;

define i1 @cmp_oeq(bfloat %a, bfloat %b) denormal_fpenv(ieee|preservesign) {
; CHECK-LABEL: cmp_oeq:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vcomisbf16 %xmm1, %xmm0
; CHECK-NEXT:    setnp %cl
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    andb %cl, %al
; CHECK-NEXT:    retq
  %r = fcmp oeq bfloat %a, %b
  ret i1 %r
}

