;===----------------------------------------------------------------------===;
; The AVX10.2 intrinsics keep selecting VCOMISBF16 regardless of the denormal
; mode: they name the instruction, so its flushing is what the caller asked for.
;===----------------------------------------------------------------------===;

define i32 @intrinsic_comi_eq(<8 x bfloat> %a, <8 x bfloat> %b) {
; CHECK-LABEL: intrinsic_comi_eq:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vcomisbf16 %xmm1, %xmm0
; CHECK-NEXT:    setnp %al
; CHECK-NEXT:    sete %cl
; CHECK-NEXT:    andb %al, %cl
; CHECK-NEXT:    movzbl %cl, %eax
; CHECK-NEXT:    retq
  %r = call i32 @llvm.x86.avx10.vcomisbf16eq(<8 x bfloat> %a, <8 x bfloat> %b)
  ret i32 %r
}

define i32 @intrinsic_comi_lt(<8 x bfloat> %a, <8 x bfloat> %b) {
; CHECK-LABEL: intrinsic_comi_lt:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    vcomisbf16 %xmm0, %xmm1
; CHECK-NEXT:    seta %al
; CHECK-NEXT:    retq
  %r = call i32 @llvm.x86.avx10.vcomisbf16lt(<8 x bfloat> %a, <8 x bfloat> %b)
  ret i32 %r
}

declare i32 @llvm.x86.avx10.vcomisbf16eq(<8 x bfloat>, <8 x bfloat>)
declare i32 @llvm.x86.avx10.vcomisbf16lt(<8 x bfloat>, <8 x bfloat>)
