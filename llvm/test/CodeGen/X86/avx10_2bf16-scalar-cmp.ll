; oeq and une are the two predicates that need both ZF and PF, so they take two
; SETcc off the one VCOMISBF16. There is no VCOMXBF16 to fold them back into
; a single flag test.
define i1 @cmp_une(bfloat %a, bfloat %b) denormal_fpenv(ieee|preservesign) {
; CHECK-LABEL: cmp_une:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vcomisbf16 %xmm1, %xmm0
; CHECK-NEXT:    setp %cl
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    orb %cl, %al
; CHECK-NEXT:    retq
  %r = fcmp une bfloat %a, %b
  ret i1 %r
}

;===----------------------------------------------------------------------===;
; Other users of the compare.
;===----------------------------------------------------------------------===;

; A bf16 operand loaded from memory is moved into an xmm register first: the
; compare matches through the packed VR128X form, so the f16mem folding variant
; of VCOMISBF16 does not apply here.
define i1 @cmp_olt_load(bfloat %a, ptr %p) denormal_fpenv(ieee|preservesign) {
; CHECK-LABEL: cmp_olt_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovsh {{.*#+}} xmm1 = mem[0],zero,zero,zero,zero,zero,zero,zero
; CHECK-NEXT:    vcomisbf16 %xmm0, %xmm1
; CHECK-NEXT:    seta %al
; CHECK-NEXT:    retq
  %b = load bfloat, ptr %p
  %r = fcmp olt bfloat %a, %b
  ret i1 %r
}

define void @cmp_ogt_br(bfloat %a, bfloat %b, ptr %p) denormal_fpenv(ieee|preservesign) {
; CHECK-LABEL: cmp_ogt_br:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vcomisbf16 %xmm1, %xmm0
; CHECK-NEXT:    jbe .LBB15_2
; CHECK-NEXT:  # %bb.1: # %then
; CHECK-NEXT:    movb $1, (%rdi)
; CHECK-NEXT:  .LBB15_2: # %exit
; CHECK-NEXT:    retq
  %c = fcmp ogt bfloat %a, %b
  br i1 %c, label %then, label %exit

then:
  store i8 1, ptr %p
  br label %exit

exit:
  ret void
}

define bfloat @cmp_olt_select(bfloat %a, bfloat %b, bfloat %x, bfloat %y) denormal_fpenv(ieee|preservesign) {
; CHECK-LABEL: cmp_olt_select:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovw %xmm3, %eax
; CHECK-NEXT:    vmovw %xmm2, %ecx
; CHECK-NEXT:    vcomisbf16 %xmm0, %xmm1
; CHECK-NEXT:    cmoval %ecx, %eax
; CHECK-NEXT:    vmovw %eax, %xmm0
; CHECK-NEXT:    retq
  %c = fcmp olt bfloat %a, %b
  %r = select i1 %c, bfloat %x, bfloat %y
  ret bfloat %r
}

;===----------------------------------------------------------------------===;
; Denormal-fp environments that keep the f32 promotion.
;===----------------------------------------------------------------------===;

; Default is IEEE, so denormal inputs must compare exactly.
define i1 @cmp_olt_default(bfloat %a, bfloat %b) {
; CHECK-LABEL: cmp_olt_default:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpslld $16, %xmm0, %xmm0
; CHECK-NEXT:    vpslld $16, %xmm1, %xmm1
; CHECK-NEXT:    vucomiss %xmm0, %xmm1
; CHECK-NEXT:    seta %al
; CHECK-NEXT:    retq
  %r = fcmp olt bfloat %a, %b
  ret i1 %r
}

; Only denormal *outputs* are flushed here; inputs are still IEEE.
define i1 @cmp_olt_flush_output_only(bfloat %a, bfloat %b) denormal_fpenv(preservesign|ieee) {
; CHECK-LABEL: cmp_olt_flush_output_only:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpslld $16, %xmm0, %xmm0
; CHECK-NEXT:    vpslld $16, %xmm1, %xmm1
; CHECK-NEXT:    vucomiss %xmm0, %xmm1
; CHECK-NEXT:    seta %al
; CHECK-NEXT:    retq
  %r = fcmp olt bfloat %a, %b
  ret i1 %r
}

; A dynamic input mode is not known to flush.
define i1 @cmp_olt_dynamic(bfloat %a, bfloat %b) denormal_fpenv(ieee|dynamic) {
; CHECK-LABEL: cmp_olt_dynamic:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpslld $16, %xmm0, %xmm0
; CHECK-NEXT:    vpslld $16, %xmm1, %xmm1
; CHECK-NEXT:    vucomiss %xmm0, %xmm1
; CHECK-NEXT:    seta %al
; CHECK-NEXT:    retq
  %r = fcmp olt bfloat %a, %b
  ret i1 %r
}

; The float: section only covers f32, so bf16 falls back on the default mode.
define i1 @cmp_olt_f32_only(bfloat %a, bfloat %b) denormal_fpenv(ieee, float: preservesign) {
; CHECK-LABEL: cmp_olt_f32_only:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpslld $16, %xmm0, %xmm0
; CHECK-NEXT:    vpslld $16, %xmm1, %xmm1
; CHECK-NEXT:    vucomiss %xmm0, %xmm1
; CHECK-NEXT:    seta %al
; CHECK-NEXT:    retq
  %r = fcmp olt bfloat %a, %b
  ret i1 %r
}

